# robust_v2 使用独立 SQLite 单账本；旧 paper JSON 仅保留为研究基线。
BROKER_MODE=paper_v2
ROBUST_V2_ACCOUNT_ID=paper_v2
ROBUST_V2_LEDGER_PATH=data/paper_v2.db
INITIAL_CAPITAL=50000

# paper/live 模式必须保持 true；false 时 robust_v2 会拒绝启动。
ENFORCE_T1=true

# 只有 QMT 接口完成 dry-run 联调并人工确认后，才允许设置为 true。
LIVE_TRADING_ENABLED=false

# 每分钟仅做行情健康检查和灾难止损，不产生普通技术买卖。
ROBUST_V2_MONITOR_INTERVAL_SECONDS=60
ROBUST_V2_LEASE_TTL_SECONDS=90
ROBUST_V2_STOCK_CANDIDATE_LIMIT=500
ROBUST_V2_MIN_MAINBOARD_UNIVERSE=1500
ROBUST_V2_MIN_REALTIME_QUOTE_COVERAGE=0.90
ROBUST_V2_MIN_HISTORY_COVERAGE=0.90
ROBUST_V2_MIN_ETF_HISTORY_COVERAGE=0.80
ROBUST_V2_MAX_EXECUTION_QUOTE_AGE_SECONDS=120
ROBUST_V2_SIGNAL_RETRY_SECONDS=60
ROBUST_V2_UNIVERSE_CACHE_MAX_AGE_SECONDS=604800
ROBUST_V2_SELECTED_CONFIG_PATH=data/robust_v2_selected.json
ROBUST_V2_BACKUP_DIR=data/backups/paper_v2
ROBUST_V2_BACKUP_RETENTION_DAYS=45
ROBUST_V2_MAX_TOTAL_POSITION=0.80
ROBUST_V2_ETF_TARGET=0.48
ROBUST_V2_STOCK_TARGET=0.32
ROBUST_V2_MIN_CASH=0.20
ROBUST_V2_MAX_SINGLE_ETF=0.24
ROBUST_V2_MAX_SINGLE_STOCK=0.16
ROBUST_V2_MIN_STOCK_ORDER_AMOUNT=4000
ROBUST_V2_REBALANCE_DAYS=20
ROBUST_V2_STOCK_STOP_PCT=0.07
ROBUST_V2_ETF_STOP_PCT=0.10
ROBUST_V2_DAILY_JOB_RETRY_SECONDS=900

# BaoStock 批次控制尾延迟；连续登录失败后短暂熔断，冷却结束自动恢复。
BAOSTOCK_HISTORY_BATCH_TIMEOUT_CAP_SECONDS=45
BAOSTOCK_RETRY_COOLDOWN_SECONDS=300

# 5 万账户默认只直接交易主板股票和 ETF。可复制 config/permissions.example.yaml
# 为 config/permissions.yaml，或用环境变量临时覆盖。
PERMISSIONS_FILE=config/permissions.yaml
ALLOW_MAIN_BOARD_STOCKS=true
ALLOW_CHINEXT_STOCKS=false
ALLOW_STAR_MARKET_STOCKS=false
ALLOW_CONVERTIBLE_BONDS=false
ALLOW_HK_CONNECT=false
ALLOW_MARGIN_TRADING=false

# 避免最低佣金和滑点吞噬收益，买入单低于该金额会被风控拒绝。
MIN_STOCK_ORDER_AMOUNT=8000
MIN_ETF_ORDER_AMOUNT=5000

# QMT / miniQMT 预留配置，当前版本不会发送真实委托。
QMT_ACCOUNT_ID=
QMT_CLIENT_PATH=

# 经 HTTPS 反向代理访问时设置为 true；本机 HTTP 调试保持 false。
DASHBOARD_COOKIE_SECURE=false

# 旧 Combo/RPS/小市值写账户入口默认关闭，仅显式研究时临时打开。
ENABLE_LEGACY_ACCOUNT_WRITERS=false
