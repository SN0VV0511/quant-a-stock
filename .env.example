# 虚拟盘默认模式，观察期不要改成 qmt。
BROKER_MODE=paper

# 只有 QMT 接口完成 dry-run 联调并人工确认后，才允许设置为 true。
LIVE_TRADING_ENABLED=false

# 盘中低频运行参数。
LIVE_WATCH_INTERVAL_SECONDS=4
LIVE_SCAN_INTERVAL_SECONDS=600

# 5 万账户默认只直接交易主板股票和 ETF。可复制 config/permissions.example.yaml
# 为 config/permissions.yaml，或用环境变量临时覆盖。
PERMISSIONS_FILE=config/permissions.yaml
ALLOW_MAIN_BOARD_STOCKS=true
ALLOW_CHINEXT_STOCKS=false
ALLOW_STAR_MARKET_STOCKS=false
ALLOW_CONVERTIBLE_BONDS=false
ALLOW_HK_CONNECT=false
ALLOW_MARGIN_TRADING=false

# 避免最低佣金和滑点吞噬收益，买入单低于该金额会被风控拒绝。
MIN_STOCK_ORDER_AMOUNT=8000
MIN_ETF_ORDER_AMOUNT=5000

# QMT / miniQMT 预留配置，当前版本不会发送真实委托。
QMT_ACCOUNT_ID=
QMT_CLIENT_PATH=
